{
  "name": "crm-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi:lint": "redocly lint ../api/openapi/openapi.yaml --config ../api/openapi/redocly.yaml",
    "openapi:bundle": "redocly bundle ../api/openapi/openapi.yaml --config ../api/openapi/redocly.yaml --output ../api/openapi/openapi.bundled.yaml",
    "openapi:ts": "openapi-typescript ../api/openapi/openapi.bundled.yaml --output src/generated/api/schema.ts",
    "openapi:go": "cd .. && go generate ./internal/platform/httpx/oapi",
    "openapi:gen": "npm run openapi:lint && npm run openapi:bundle && npm run openapi:ts && npm run openapi:go"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.72.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

{
  "title": "CRM R3 staging operations (proposed)",
  "uid": "crm-r3-staging",
  "schemaVersion": 39,
  "tags": [
    "crm",
    "r3",
    "proposed"
  ],
  "description": "R3 reference dashboard. Thresholds are proposed; a dashboard is not proof that alerts are delivered.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by class",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (class) (rate(crm_api_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crm_api_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Login outcomes (counts only)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(crm_api_login_outcomes_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB pool saturation by owner",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "max by (owner) (crm_db_pool_acquired_conns / clamp_min(crm_db_pool_max_conns, 1))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker readiness / dependencies",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "crm_worker_ready or crm_worker_check_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job state: blocked / paused / failing",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "crm_worker_job_state_blocked or crm_worker_job_state_paused or crm_worker_job_state_failing",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Seconds since last successful pass",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "time() - crm_worker_job_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox backlog / oldest age",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "crm_worker_outbox_pending or crm_worker_outbox_oldest_pending_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Delivery exhausted",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "crm_worker_outbox_exhausted",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Write-back UNKNOWN / reconciliation / parity",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "crm_worker_writeback_unknown or crm_worker_writeback_reconciliation_required or crm_worker_writeback_parity_conflicts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Provider UNKNOWN / reconciliation / conflicts",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "crm_worker_provider_unknown or crm_worker_provider_reconciliation_required or crm_worker_provider_conflicting_callbacks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Receipts STORAGE_ERROR / NOT_RECOVERABLE",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "crm_worker_receipt_storage_error or crm_worker_receipt_not_recoverable",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Feature flags enabled / attestation",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "expr": "crm_worker_feature_flags_enabled or crm_worker_environment_attested",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Backup age (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "expr": "time() - crm_backup_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Restore rehearsal last result / recovery seconds",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "crm_restore_rehearsal_last_run_success or crm_restore_rehearsal_last_recovery_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Build revision",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "expr": "crm_build_info",
          "refId": "A"
        }
      ]
    }
  ]
}

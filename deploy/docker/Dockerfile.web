# R3 web image: the verified web bundle (web-dist.tar.gz from the release
# artifact) on pinned nginx. TLS material and nginx.conf are mounted at
# runtime; nothing secret is in the image.
#
#   docker build -f deploy/docker/Dockerfile.web -t crm-web:<commit12> <artifact-dir>
FROM nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
ARG CRM_COMMIT=unknown
LABEL org.opencontainers.image.title="crm-web" org.opencontainers.image.revision="${CRM_COMMIT}"
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf
ADD web-dist.tar.gz /usr/share/nginx/html/

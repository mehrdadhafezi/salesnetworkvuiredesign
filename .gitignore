# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Database / private exports
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.dump
# Exception: versioned target migrations and test-only synthetic schemas are source code.
!internal/platform/migrations/sql/*.sql
!internal/platform/pgtest/synthetic/*.sql
# Slice 3: integration staging migrations (DDL only, no data) and lint fixtures.
!internal/integration/legacy/migrations/sql/*.sql
!internal/integration/legacy/migrations/body/*.sql
!internal/architecture/testdata/**/*.sql
# Slice 4: identity and organization read-model migrations (DDL + reference data only).
!internal/identity/migrations/sql/*.sql
!internal/identity/migrations/body/*.sql
!internal/organization/migrations/sql/*.sql
!internal/organization/migrations/body/*.sql
# Slice 5: customers shadow model and identity capability reference data.
!internal/customers/migrations/sql/*.sql
!internal/customers/migrations/body/*.sql
# Slice 6: cases and custody shadow models.
!internal/cases/migrations/sql/*.sql
!internal/cases/migrations/body/*.sql
!internal/custody/migrations/sql/*.sql
!internal/custody/migrations/body/*.sql
# Slice 7: billing and payments shadow models.
!internal/billing/migrations/sql/*.sql
!internal/billing/migrations/body/*.sql
!internal/payments/migrations/sql/*.sql
!internal/payments/migrations/body/*.sql
# Slice 8: reporting projections.
!internal/reporting/migrations/sql/*.sql
!internal/reporting/migrations/body/*.sql
# Slice 9: finance SHADOW ledger.
!internal/finance/migrations/sql/*.sql
!internal/finance/migrations/body/*.sql
# Slice 10: biawin / fulfillment READ shadow.
!internal/biawin/migrations/sql/*.sql
!internal/biawin/migrations/body/*.sql
!internal/fulfillment/migrations/sql/*.sql
!internal/fulfillment/migrations/body/*.sql
# Slice 13: commission controlled SHADOW.
!internal/commission/migrations/sql/*.sql
!internal/commission/migrations/body/*.sql
# Slice 14: catalog service model.
!internal/catalog/migrations/sql/*.sql
!internal/catalog/migrations/body/*.sql

# Legacy snapshot packages may contain PII: never committed (Slice 3, D-23).
# Tests build synthetic packages in temporary directories only.
*.ndjson
snapshots/
legacy-snapshot*/
crm-legacy-snapshot*/

# Logs / temp
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Archives / deployment artifacts
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Node
node_modules/
.next/
dist/
build/
coverage/
.cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Agent local/session state
.claude/
.codex/

# Test/runtime local artifacts
.phpunit.result.cache
.cache/
tmp/
temp/

# WordPress runtime/user data if ever copied
wp-content/cache/
wp-content/uploads/
wp-content/upgrade/
wp-content/backups/
wp-content/ai1wm-backups/

# Credentials / sessions
cookies*
session*
credentials*
secrets*
auth.json
# R1: Go source of the server-side session implementation (code, never
# session data). Narrow re-includes only; the patterns above still keep
# every runtime session / credential / secret artifact out of git.
!internal/authorization/session.go
!internal/authorization/session_test.go
!internal/identity/session/
!internal/identity/session/*.go
!internal/integration/biawin/session_authz_e2e_test.go

# Previous local Git metadata backup
.git-old-backup/

# R3: build outputs never belong in the repository (binaries at the root,
# release artifacts, staging secrets and local backups).
/crm-*
!/crm-*/
/dist/
/deploy/staging/.secrets/
/deploy/staging/.state/

# R7-1 Playwright full-stack E2E output (never committed)
web/test-results/
web/playwright-report/
